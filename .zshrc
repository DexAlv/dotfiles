# =========================
# Zsh Configuration
# =========================

# Prompt
PROMPT='%F{cyan}╭─ 🐧 %n
╰─ %F{blue}%~ %B%F{green}❯%f '

# Aliases
alias ls='ls --color=auto'
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias c='clear'

# Custom variables
export EDITOR=nvim
export VISUAL=nvim
